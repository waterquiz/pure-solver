# Environment mode: development | production | test
APP_ENV=production

# Application Secret Key (Used for JWT signing and session security)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# Base URL for generated image links and public display (e.g. https://yourdomain.com)
SERVER_HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Railway Database / PostgreSQL URL
# Railway automatically supplies DATABASE_URL.
# If omitted or left empty, defaults to local SQLite: sqlite:///./data.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/remote_image_db

# Image Upload Constraints
MAX_IMAGE_SIZE_MB=10

# API Rate Limiting (per API Key or IP)
RATE_LIMIT=100
RATE_LIMIT_WINDOW=60

# Allowed CORS Origins (comma-separated, e.g. https://yourdomain.com,https://dashboard.yourdomain.com)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Image Storage Provider: "local" or "s3"
# Use "s3" for Railway / production (AWS S3, Cloudflare R2, MinIO, Backblaze B2, Supabase Storage)
# Use "local" for local testing / development
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# S3 Configuration (Required if STORAGE_PROVIDER=s3)
STORAGE_BUCKET=my-image-bucket
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_ACCESS_KEY=your-access-key-id
STORAGE_SECRET_KEY=your-secret-access-key
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL_PREFIX=
